# Токен бота от @BotFather (тот же бот @sinitsa_chai_bot)
BOT_TOKEN=
# Адрес, по которому открывается приложение (для Telegram нужен https)
PUBLIC_URL=https://shop.example.ru
# Telegram ID продавцов через запятую. Узнать свой: написать боту /id
ADMIN_IDS=
# Домен для HTTPS-сертификата (docker-compose), тот же, что в PUBLIC_URL, без https://
DOMAIN=shop.example.ru
# Группа для заказов, вопросов и отзывов (необязательно). Узнать ID: написать в группе /chatid
ORDERS_CHAT_ID=
# Продавец для политики конфиденциальности и согласия (/privacy, /consent)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_EMAIL=
# Адрес оператора (по 152-ФЗ указывается в согласии). Для физлица — адрес регистрации, можно без квартиры уточнить у юриста
OPERATOR_ADDRESS=
