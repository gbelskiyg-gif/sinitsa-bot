# Токен бота от @BotFather (тот же бот @sinitsa_chai_bot)
BOT_TOKEN=
# Адрес, по которому открывается приложение (для Telegram нужен https)
PUBLIC_URL=https://shop.example.ru
# Telegram ID продавцов через запятую. Узнать свой: написать боту /id
ADMIN_IDS=
# Домен для HTTPS-сертификата (docker-compose), тот же, что в PUBLIC_URL, без https://
DOMAIN=shop.example.ru
# Адреса, которые перенаправляются на DOMAIN (через пробел). По умолчанию — www.DOMAIN.
# При переезде добавьте сюда старый адрес, чтобы не сломались старые ссылки и кнопки в чатах.
# REDIRECT_FROM=www.shop.example.ru old.example.ru
# Группа для заказов, вопросов и отзывов (необязательно). Узнать ID: написать в группе /chatid
ORDERS_CHAT_ID=
# Продавец для политики конфиденциальности и согласия (/privacy, /consent)
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_EMAIL=
# Адрес оператора: по 152-ФЗ указывается в согласии. Для физлица — адрес регистрации
OPERATOR_ADDRESS=
# Письма покупателям (подтверждение, реквизиты/QR, статусы) с ящика Яндекса.
# SMTP_PASS — не обычный пароль, а «пароль приложения» из Яндекс ID → Безопасность → Пароли приложений (тип «Почта»).
SMTP_USER=Sinitsa-chai@yandex.ru
SMTP_PASS=

# Онлайн-оплата и чеки через ЮKassa (личный кабинет yookassa.ru → Интеграция → Ключи API).
# Пока ключи пустые — оплата переводом по реквизитам, как раньше.
# В кабинете ЮKassa: Интеграция → HTTP-уведомления → адрес https://ВАШ_ДОМЕН/api/yookassa,
# события payment.succeeded и payment.canceled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — включить подписку с ежемесячным автосписанием (сначала попросите ЮKassa включить автоплатежи)
YOOKASSA_RECURRING=
# Код системы налогообложения в чеке, если ЮKassa попросит: 2 — УСН «доходы»
# YOOKASSA_TAX_SYSTEM=2
