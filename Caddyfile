# Caddy сам выпускает HTTPS-сертификаты для всех адресов ниже.
# DOMAIN — основной адрес сайта (из .env).
{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}

# Старый адрес (OLD_DOMAIN) тоже обслуживаем, а не перенаправляем: мини-приложение,
# открытое кнопкой из старого сообщения, не должно уходить на другой домен —
# Telegram тогда спрашивает «Перейти по ссылке?» на каждое нажатие.
{$OLD_DOMAIN:localhost} {
	encode gzip
	reverse_proxy app:3000
}

# www и другие дополнительные адреса — навсегда на основной (REDIRECT_FROM в .env, через пробел).
{$REDIRECT_FROM} {
	redir https://{$DOMAIN}{uri} permanent
}
